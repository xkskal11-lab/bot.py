-- ---------- ESP ----------
local espEnabled = false
local espConnections = {}
local function addESPToCharacter(char, name)
	if not char then return end
	if char:FindFirstChild("SZ_ESP_Billboard") then return end
	local head = char:FindFirstChild("Head")
	if not head then return end

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "SZ_ESP_Billboard"
	billboard.Adornee = head
	billboard.Size = UDim2.new(0,120,0,30)
	billboard.AlwaysOnTop = true
	billboard.Parent = char

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1,0,1,0)
	label.BackgroundTransparency = 1
	label.Text = name
	label.TextColor3 = Color3.fromRGB(0,255,0)
	label.Font = Enum.Font.SourceSansBold
	label.TextScaled = true
	label.Parent = billboard
end

local function enableESP()
	if espEnabled then return end
	espEnabled = true
	for _, plr in pairs(Players:GetPlayers()) do
		if plr ~= player then
			if plr.Character then
				addESPToCharacter(plr.Character, plr.Name)
			end
			espConnections[plr] = plr.CharacterAdded:Connect(function(char)
				addESPToCharacter(char, plr.Name)
			end)
		end
	end
	espConnections["_playerAdded"] = Players.PlayerAdded:Connect(function(plr)
		if plr ~= player then
			espConnections[plr] = plr.CharacterAdded:Connect(function(char)
				addESPToCharacter(char, plr.Name)
			end)
			if plr.Character then
				addESPToCharacter(plr.Character, plr.Name)
			end
		end
	end)
end

espBtn.MouseButton1Click:Connect(function()
	espBtn:Destroy()
	menuFrame.Visible = false
	enableESP()
end)

-- ---------- Part Control ----------
local liftPartInstance = nil
local liftFollowConn = nil
local liftRiseConn = nil
local liftActive = false
local LIFT_SPEED = 1.2

local function createLiftControlGui()
	local liftGui = Instance.new("ScreenGui")
	liftGui.Name = "SZ_Lift_Control"
	liftGui.ResetOnSpawn = false
	liftGui.Parent = PlayerGui

	local rect = Instance.new("Frame")
	rect.Size = UDim2.new(0,220,0,90)
	rect.Position = UDim2.new(0.5,-110,0.55,-45)
	rect.BackgroundColor3 = Color3.fromRGB(40,40,40)
	rect.BorderSizePixel = 0
	rect.Active = true
	rect.Draggable = true
	rect.Parent = liftGui

	local lab = Instance.new("TextLabel")
	lab.Size = UDim2.new(1,-10,0,24)
	lab.Position = UDim2.new(0,5,0,6)
	lab.BackgroundTransparency = 1
	lab.Font = Enum.Font.SourceSansBold
	lab.TextSize = 16
	lab.Text = "تحكم Part"
	lab.TextColor3 = Color3.fromRGB(255,255,255)
	lab.Parent = rect

	local toggleBtn = Instance.new("TextButton")
	toggleBtn.Size = UDim2.new(0.86,0,0,40)
	toggleBtn.Position = UDim2.new(0.07,0,0.45,0)
	toggleBtn.Font = Enum.Font.SourceSansBold
	toggleBtn.TextSize = 18
	toggleBtn.Parent = rect

	local function setStoppedVisual()
		toggleBtn.Text = "بارت: إيقاف"
		toggleBtn.BackgroundColor3 = Color3.fromRGB(200,40,40)
	end
	local function setRunningVisual()
		toggleBtn.Text = "بارت: تشغيل"
		toggleBtn.BackgroundColor3 = Color3.fromRGB(50,200,80)
	end

	setStoppedVisual()

	toggleBtn.MouseButton1Click:Connect(function()
		if liftActive then
			liftActive = false
			setStoppedVisual()
			if liftFollowConn then liftFollowConn:Disconnect() end
			if liftRiseConn then liftRiseConn:Disconnect() end
			if liftPartInstance then liftPartInstance:Destroy() liftPartInstance = nil end
		else
			liftActive = true
			setRunningVisual()

			local char = player.Character or player.CharacterAdded:Wait()
			local root = char:WaitForChild("HumanoidRootPart")
			local humanoid = char:FindFirstChildWhichIsA("Humanoid")

			liftPartInstance = Instance.new("Part")
			liftPartInstance.Size = Vector3.new(6,1,6)
			liftPartInstance.Anchored = true
			liftPartInstance.CanCollide = true
			liftPartInstance.Color = Color3.fromRGB(100,255,100)
			liftPartInstance.Parent = workspace

			liftFollowConn = RunService.Heartbeat:Connect(function()
				if root and liftPartInstance then
					local footY = root.Position.Y - (humanoid and humanoid.HipHeight or 2) - (root.Size.Y/2) - 0.2
					liftPartInstance.Position = Vector3.new(root.Position.X, footY, root.Position.Z)
				end
			end)

			liftRiseConn = RunService.Heartbeat:Connect(function(dt)
				if liftPartInstance and liftActive then
					liftPartInstance.Position += Vector3.new(0, dt * LIFT_SPEED, 0)
				end
			end)
		end
	end)
end

